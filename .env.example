DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=food_reservation
POSTGRES_USER=food_reservation
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Reservation deadline: previous day, 0-23 (Tehran time)
DOCKER_COMPOSE_RESERVATION_CUTOFF_HOUR=10
