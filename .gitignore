.env
.venv/
__pycache__/
*.py[cod]
*.sqlite3
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
staticfiles/
frontend/node_modules/
frontend/dist/

# Local secret values. Keep only safe templates in version control.
secrets/*.txt
!secrets/*.example.txt

frontend/.pnpm-store/

# Django uploaded media
/media/**
!/media/.gitkeep
!/media/foods/
!/media/foods/.gitkeep
!/media/sides/
!/media/sides/.gitkeep
!/media/drinks/
!/media/drinks/.gitkeep
